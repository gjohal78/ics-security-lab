# ics-security-lab — Suricata rules for the SEGMENTED lab (docker-compose.segmented.yml).
# Same four signatures as local.rules, re-addressed to the zone subnets. The
# sensors sniff the supervisory bridge (br-sup), so the vantage point is the
# HMI->PLC conduit: these rules now mainly catch a COMPROMISED HMI (which should
# only ever read), complementing the firewall that drops the writes. The
# corporate attacker is blocked at the firewall and is not visible here — its
# attempts show up in the firewall's logs instead. See detection/README.md for
# the line-by-line explanation (addresses differ, logic is identical).
#
# Zone addresses: PLC 172.30.1.10, simulator 172.30.1.20, HMI 172.30.2.30.

# 1) Any Modbus write toward the PLC from a non-simulator host (on this segment,
#    that means the HMI writing — it should only read).
alert modbus !172.30.1.20 any -> 172.30.1.10 502 (msg:"ICS-LAB Unauthorized Modbus write (source is not the simulator)"; flow:to_server,established; modbus:access write; classtype:attempted-admin; sid:1000001; rev:1; metadata:attack unauthorized_write;)

# 2) Write to holding register 1024 (%MW0, level) — the sensor spoof. Byte match
#    (protocol id 00 00 at offset 2; FC6 06 + address 0400 at offset 7).
alert tcp !172.30.1.20 any -> 172.30.1.10 502 (msg:"ICS-LAB Level register spoof (FC6 write to %MW0 / holding 1024 from unauthorized host)"; flow:to_server,established; content:"|00 00|"; offset:2; depth:2; content:"|06 04 00|"; offset:7; depth:3; classtype:attempted-admin; sid:1000002; rev:2; metadata:attack sensor_spoof;)

# 3) Burst of writes from one non-simulator host (>15 in 2 s).
alert modbus !172.30.1.20 any -> 172.30.1.10 502 (msg:"ICS-LAB Burst of Modbus writes from one host (override/flood)"; flow:to_server,established; modbus:access write; detection_filter:track by_src, count 15, seconds 2; classtype:attempted-dos; sid:1000003; rev:1; metadata:attack write_burst;)

# 4) Read from any host that is neither the simulator nor the HMI — an
#    unexpected reader in the supervisory zone (recon).
alert modbus ![172.30.1.20,172.30.2.30] any -> 172.30.1.10 502 (msg:"ICS-LAB Register scan (Modbus read from an unexpected host)"; flow:to_server,established; modbus:access read; classtype:attempted-recon; sid:1000004; rev:1; metadata:attack register_scan;)
